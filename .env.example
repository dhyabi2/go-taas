# Example environment file for the local docker-compose verification
# stack. Copy to `.env` (which is git-ignored) and fill in the values:
#
#   cp .env.example .env
#
# `make compose-up` reads it via `docker compose --env-file .env`. Every
# value is consumed either by the `juicefs` service or forwarded to the
# control plane / controller through `CONFIG_*` overrides in
# deploy/compose/docker-compose.yaml.

# ---- Internal Harbor registry (image import) --------------------------
# The image-import flow pulls an engine image from a source registry and
# pushes it into <HARBOR_URL>/<HARBOR_PROJECT>. HARBOR_URL is the
# registry host WITHOUT scheme (e.g. hub.example.com).
HARBOR_URL=hub.example.com
HARBOR_USERNAME=admin
HARBOR_PASSWORD=changeme

# ---- JuiceFS model-weights filesystem ---------------------------------
# Shared by the compose control plane (mounted at /data/weights) and the
# inference pods (mounted through the cluster StorageClass). Backed by
# the cluster MinIO bucket and metadata in the cluster Redis DB 1.
#
# The cluster Redis is not reachable from the host: publish it with
#   kubectl apply -f deploy/compose/cluster-prereqs.yaml
# and set JUICE_FS_META_URL to redis://<node-ip>:30379/1 (the cluster
# Redis has no password, so the URL carries none).
JUICE_FS_NAME=jfs-taas-models
JUICE_FS_META_URL=redis://<node-ip>:30379/1
JUICE_FS_STORAGE=s3
# MinIO is exposed on the node IP (hostNetwork); use http://<node-ip>:9000/<bucket>.
JUICE_FS_BUCKET=http://<node-ip>:9000/taas
JUICE_FS_ACCESS_KEY=minio-access-key
JUICE_FS_SECRET_KEY=minio-secret-key

# ---- Kubernetes weights storage ---------------------------------------
# The JuiceFS-backed StorageClass the controller provisions the shared
# model-weights PVC from. Must match the StorageClass created in the
# cluster (pathPattern "/" so the whole filesystem is mounted).
WEIGHTS_STORAGE_CLASS=juicefs-taas-models

# Optional overrides ----------------------------------------------------
# CONTROLLER_NAMESPACE=taas
# KUBECONFIG=/path/to/kubeconfig
# JUICE_FS_HOST_MOUNT=/var/lib/go-taas/juicefs
